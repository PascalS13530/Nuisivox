const page = {"title": "Nid de guêpes sous le toit ou les tuiles : que faire ?", "description": "Des guêpes entrent et sortent entre les tuiles ou sous la génoise ? Bons réflexes et destruction du nid sous toiture à Marseille, Aix, Aubagne.", "canonical": "https://nuisivox.fr/nid-de-guepes-toit.html", "ogType": "website", "ogTitle": "Nid de guêpes sous le toit ou les tuiles : que faire ?", "ogDescription": "Des guêpes entrent et sortent entre les tuiles ou sous la génoise ? Bons réflexes et destruction du nid sous toiture à Marseille, Aix, Aubagne.", "ogUrl": "https://nuisivox.fr/nid-de-guepes-toit.html", "ogImage": "https://nuisivox.fr/equipe-guepes-aix-en-provence.jpg", "jsonld": ["[{\"@context\": \"https://schema.org\", \"@type\": \"BreadcrumbList\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"Accueil\", \"item\": \"https://nuisivox.fr/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"Nid de guêpes sous le toit\", \"item\": \"https://nuisivox.fr/nid-de-guepes-toit.html\"}]}, {\"@context\": \"https://schema.org\", \"@type\": \"FAQPage\", \"mainEntity\": [{\"@type\": \"Question\", \"name\": \"Faut-il retirer des tuiles pour détruire le nid ?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"Dans la plupart des cas, non : le traitement se fait par l'entrée, et les guêpes rapportent le produit dans le nid.\"}}, {\"@type\": \"Question\", \"name\": \"Le nid reviendra-t-il l'année prochaine ?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"Un nid traité n'est pas réoccupé. Mais une autre reine peut choisir le même endroit : reboucher l'entrée après traitement limite ce risque.\"}}, {\"@type\": \"Question\", \"name\": \"Combien de temps après le traitement les guêpes disparaissent-elles ?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"L'activité diminue en général dans les heures qui suivent. Quelques guêpes de retour peuvent tourner un jour ou deux.\"}}, {\"@type\": \"Question\", \"name\": \"Faut-il un échafaudage pour traiter un nid sous le toit ?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"Rarement : une perche télescopique ou une échelle suffit le plus souvent pour atteindre l'entrée du nid.\"}}, {\"@type\": \"Question\", \"name\": \"Le nid sous les tuiles doit-il être retiré ?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"Ce n'est pas obligatoire : un nid traité n'est plus occupé. Il peut être retiré lors de travaux de toiture.\"}}]}]", "{\"@context\": \"https://schema.org\", \"@type\": \"WebPage\", \"@id\": \"https://nuisivox.fr/nid-de-guepes-toit.html#page\", \"url\": \"https://nuisivox.fr/nid-de-guepes-toit.html\", \"name\": \"Nid de guêpes sous le toit ou les tuiles : que faire ?\", \"inLanguage\": \"fr-FR\", \"datePublished\": \"2026-11-02\", \"dateModified\": \"2026-11-02\", \"author\": {\"@id\": \"https://nuisivox.fr/#entreprise\"}, \"publisher\": {\"@id\": \"https://nuisivox.fr/#entreprise\"}, \"isPartOf\": {\"@type\": \"WebSite\", \"@id\": \"https://nuisivox.fr/#site\", \"name\": \"NuisiVox\", \"url\": \"https://nuisivox.fr/\"}, \"speakable\": {\"@type\": \"SpeakableSpecification\", \"cssSelector\": [\"h1\", \".lead\"]}}", "{\"@context\": \"https://schema.org\", \"@type\": [\"Organization\", \"LocalBusiness\"], \"@id\": \"https://nuisivox.fr/#entreprise\", \"name\": \"NuisiVox\", \"url\": \"https://nuisivox.fr/\", \"logo\": \"https://nuisivox.fr/logo.svg\", \"areaServed\": [\"Marseille\", \"Aix-en-Provence\", \"Aubagne\", \"Bouches-du-Rhône\"], \"address\": {\"@type\": \"PostalAddress\", \"streetAddress\": \"390 chemin de Bourdin\", \"postalCode\": \"13530\", \"addressLocality\": \"Trets\", \"addressRegion\": \"Bouches-du-Rhône\", \"addressCountry\": \"FR\"}, \"telephone\": \"+33660687819\", \"founder\": {\"@type\": \"Person\", \"name\": \"Mathias Sergent\", \"jobTitle\": \"Fondateur, applicateur titulaire du Certibiocide\"}}"]};
---
<Base page={page} actif="nid-de-guepes-toit.html"><main><section class="hero"><div class="wrap">
<div class="hero-text"><span class="breadcrumb"><a href="index.html">Accueil</a> / Nid de guêpes sous le toit</span><span class="eyebrow">Votre question</span><h1>Un nid de guêpes <em>sous le toit</em>&nbsp;: que faire&nbsp;?</h1><p class="lead">Des guêpes qui entrent et sortent toujours au même endroit, entre deux tuiles ou sous la génoise&nbsp;: le nid est dans la toiture. Il se traite sans démonter le toit dans la plupart des cas.</p>
<div class="hero-actions"><a class="btn btn-primary" href="contact.html">Faire détruire le nid</a><span class="phone">06 60 68 78 19</span></div>
<p class="updated">Mis à jour le <time datetime="2026-11-02">2 novembre 2026</time> · par <a href="techniciens.html" rel="author">Mathias Sergent</a>, technicien certifié</p><ul class="trust"><li>Technicien certifié Certibiocide</li><li>Particuliers et professionnels</li><li>Tout le département 13</li></ul></div>
<div class="hero-art"><Photo src={"equipe-guepes-aix-en-provence.jpg"} alt={"Technicien sur une échelle traitant un nid de guêpes en façade d'une maison à Aix-en-Provence"} width={"900"} height={"1200"} fetchpriority={"high"} /></div></div></section>
<section class="block"><div class="wrap split">
  <div class="prose"><div class="section-head"><span class="eyebrow">Les bons réflexes</span><h2>Ce qu'il ne faut surtout pas faire</h2></div><ul><li><strong>Ne bouchez pas l'entrée</strong>&nbsp;: les guêpes chercheraient une autre sortie, parfois vers les combles et l'intérieur de la maison.</li><li><strong>Ne montez pas</strong> sur le toit ou dans les combles pour inspecter.</li><li><strong>Ne pulvérisez pas</strong> d'insecticide ménager dans l'entrée&nbsp;: vous excitez la colonie sans l'atteindre.</li><li>Fermez les fenêtres de toit proches et gardez les enfants à distance.</li></ul></div>
  <div class="prose"><div class="section-head"><span class="eyebrow">Guêpes, frelons ou abeilles</span><h2>Identifier depuis le sol</h2></div><p>Des insectes fins, jaunes et noirs&nbsp;: ce sont des guêpes. Plus gros et sombres, avec un anneau orange&nbsp;: des <a href="frelons-asiatiques.html">frelons asiatiques</a>.</p><p>Des abeilles, plus brunes et velues, peuvent aussi s'installer sous une toiture&nbsp;: elles ne sont pas détruites, un apiculteur peut intervenir.</p><p>Une photo prise de loin, au téléphone, suffit souvent pour confirmer.</p></div>
</div></section>
<section class="block"><div class="wrap"><div class="section-head"><span class="eyebrow">Notre méthode</span><h2>Comment on traite un nid sous toiture</h2></div><ol class="steps"><li><strong>Repérage</strong><p>Observation du va-et-vient pour localiser l'entrée exacte.</p></li><li><strong>Accès</strong><p>Intervention depuis l'extérieur à l'échelle ou à la perche, sans démonter la couverture dans la plupart des cas.</p></li><li><strong>Traitement</strong><p>Insecticide adapté appliqué dans l'entrée&nbsp;: les guêpes le rapportent dans le nid.</p></li><li><strong>Après</strong><p>L'activité cesse en général dans les heures qui suivent. L'entrée peut ensuite être rebouchée.</p></li></ol></div></section>
<section class="block"><div class="wrap"><div class="section-head"><span class="eyebrow">Le bon moment</span><h2>Pourquoi ne pas attendre l'automne</h2></div><div class="prose"><p>Un nid sous toiture grossit tout l'été. En fin d'été, il peut abriter plusieurs milliers de guêpes, plus agressives. Le traiter dès qu'on le repère est plus simple et plus sûr.</p><p>Si les guêpes entrent dans les combles ou si vous entendez un bourdonnement au plafond, voir aussi <a href="bruits-dans-les-combles.html">bruits dans les combles</a>.</p></div></div></section>
<section class="block"><div class="wrap"><div class="section-head"><span class="eyebrow">Zone d'intervention</span><h2>Destruction de nids sous toiture dans les Bouches-du-Rhône</h2></div><div class="prose"><p>Nous intervenons à <a href="marseille.html">Marseille</a> (16 arrondissements), dans le <a href="aix-en-provence.html">Pays d'Aix</a> et autour d'<a href="aubagne.html">Aubagne</a>, depuis notre base de <a href="trets.html">Trets</a>. Nous passons aussi régulièrement à <a href="gardanne.html">Gardanne</a> et à <a href="gemenos.html">Gémenos</a>.</p><p>Le rendez-vous est fixé à l'appel, du lundi au samedi de 8 h à 19 h. Décrivez ce que vous voyez, ou envoyez une photo&nbsp;: cela nous aide à venir avec le bon matériel.</p></div></div></section>
<section class="block"><div class="wrap"><div class="prose"><div class="section-head"><span class="eyebrow">En pratique</span><h2>Nid de guêpes sous le toit&nbsp;: que faire&nbsp;?</h2></div><div class="table-wrap"><table class="data compact"><thead><tr><th scope="col">Signe</th><th scope="col">Ce que ça indique</th><th scope="col">Que faire</th></tr></thead><tbody><tr><th scope="row">Guêpes entre deux tuiles</th><td>Nid sous la couverture</td><td>Traitement par l'entrée</td></tr><tr><th scope="row">Guêpes sous la génoise</th><td>Nid dans le vide de génoise</td><td>Traitement ciblé, sans démolir</td></tr><tr><th scope="row">Bourdonnement dans les combles</th><td>Nid sur une charpente</td><td>Ne pas y accéder seul</td></tr><tr><th scope="row">Guêpes dans une chambre sous toit</th><td>Nid traversant le plafond</td><td>Fermer la pièce et appeler</td></tr></tbody></table></div><p>Par exemple, un nid sous les tuiles peut traverser l'isolant et déboucher dans une chambre mansardée. En pratique, observez l'entrée de loin, en fin de journée, pour indiquer où elle se trouve. Concrètement, le produit est appliqué par l'entrée du nid&nbsp;: il n'est pas nécessaire de déposer les tuiles. Exemple courant&nbsp;: des guêpes qui entrent sous une génoise au-dessus d'une fenêtre.</p></div></div></section><section class="block"><div class="wrap"><div class="section-head"><span class="eyebrow">Questions fréquentes</span><h2>Nid de guêpes sous le toit&nbsp;: vos questions</h2></div><div class="faq"><details><summary>Faut-il retirer des tuiles pour détruire le nid&nbsp;?</summary><p>Dans la plupart des cas, non&nbsp;: le traitement se fait par l'entrée, et les guêpes rapportent le produit dans le nid.</p></details><details><summary>Le nid reviendra-t-il l'année prochaine&nbsp;?</summary><p>Un nid traité n'est pas réoccupé. Mais une autre reine peut choisir le même endroit&nbsp;: reboucher l'entrée après traitement limite ce risque.</p></details><details><summary>Combien de temps après le traitement les guêpes disparaissent-elles&nbsp;?</summary><p>L'activité diminue en général dans les heures qui suivent. Quelques guêpes de retour peuvent tourner un jour ou deux.</p></details><details><summary>Faut-il un échafaudage pour traiter un nid sous le toit&nbsp;?</summary><p>Rarement&nbsp;: une perche télescopique ou une échelle suffit le plus souvent pour atteindre l'entrée du nid.</p></details><details><summary>Le nid sous les tuiles doit-il être retiré&nbsp;?</summary><p>Ce n'est pas obligatoire&nbsp;: un nid traité n'est plus occupé. Il peut être retiré lors de travaux de toiture.</p></details></div></div></section><section class="block linkhub-wrap"><div class="wrap"><div class="section-head"><span class="eyebrow">Pour aller plus loin</span><h2>Sur le même sujet</h2></div><ul class="linkhub"><li><a href="guepes.html">Destruction de nids de guêpes</a></li><li><a href="frelons-asiatiques.html">Nid de frelons asiatiques</a></li><li><a href="bruits-dans-les-combles.html">Bruits dans les combles</a></li><li><a href="aix-en-provence.html">Interventions à Aix-en-Provence</a></li><li><a href="gemenos.html">Nuisibles à Gémenos</a></li></ul></div></section><section class="block"><div class="wrap"><div class="section-head"><span class="eyebrow">Sources officielles</span><h2>Pour en savoir plus</h2></div><ul class="linkhub"><li><a href="https://www.ecologie.gouv.fr/politiques-publiques/produits-biocides" rel="noopener" target="_blank">Les produits biocides (ministère de la Transition écologique)</a></li></ul></div></section></main><section class="cta"><div class="wrap"><div class="box">
  <div><h2>Un nuisible chez vous&nbsp;?</h2><p>Décrivez ce que vous voyez, on vous rappelle pour fixer un diagnostic.</p></div>
  <div class="hero-actions"><span class="phone">06 60 68 78 19</span><a class="btn btn-dark" href="contact.html">Demander une intervention</a></div>
</div></div></section>
</Base>
